{
  "openapi": "3.1.0",
  "info": {
    "title": "Neon Workspace API",
    "description": "Errors share one shape: {\"error\": {\"code\", \"message\"}}.",
    "license": {
      "name": "PolyForm-Noncommercial-1.0.0",
      "identifier": "PolyForm-Noncommercial-1.0.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": ["meta"],
        "summary": "Instance metadata",
        "description": "The instance name and the server version. Needs no authentication.",
        "operationId": "get_meta",
        "responses": {
          "200": {
            "description": "Instance metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Meta" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "description": "The instance name." },
          "version": { "type": "string", "description": "The server version." }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "description": "A stable, machine-readable error code." },
          "message": { "type": "string", "description": "A human-readable message." }
        }
      }
    }
  }
}
