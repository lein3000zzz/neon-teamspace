{
  "openapi": "3.1.0",
  "info": {
    "title": "Neon Workspace API",
    "description": "The HTTP API of Neon Workspace.\n\nEvery error response has the same body: `{\"error\": {\"code\": string, \"message\": string}}`. `code` is stable and meant for programs, such as `not_found` or `invalid_json`; `message` says what went wrong, for people.",
    "license": {
      "name": "PolyForm-Noncommercial-1.0.0",
      "identifier": "PolyForm-Noncommercial-1.0.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Instance metadata",
        "description": "The instance's name and the server's version. Needs no authentication, so clients can check they reached a Neon server.",
        "operationId": "get_meta",
        "responses": {
          "200": {
            "description": "Instance metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "Every error response's body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "What went wrong.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable and meant for programs, such as `not_found` or `invalid_json`.",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "description": "What went wrong, for people.",
            "example": "no such route"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The instance's name, from the `instance.name` setting.",
            "example": "Neon Workspace"
          },
          "version": {
            "type": "string",
            "description": "The server's version.",
            "example": "0.1.0"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "What the server is."
    }
  ]
}
