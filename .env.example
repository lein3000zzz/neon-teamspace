# Copy to .env, which git ignores. The values match deployments/docker-compose.dev.yml.

# Read by sqlx: the query macros at build time, sqlx-cli, and #[sqlx::test].
DATABASE_URL=postgres://neon:neon@127.0.0.1:55432/neon

# Read by the server. Any key of neon.example.yaml can be set this way.
NEON_DATABASE__URL=postgres://neon:neon@127.0.0.1:55432/neon

# Mail, into the dev compose file's Mailpit: make db-up starts it, and its inbox is at
# http://127.0.0.1:58025/. Uncomment these to send mail. Mail links point to the public URL,
# here the web app's dev server, so with it set, browsers must reach the server through
# make web-dev. Queued mail is sealed with a secret key; make one with
#   echo "dev:$(openssl rand -base64 32)"
# and put it after NEON_SECRETS__KEYS=. Settings set here are pinned: the admin page shows
# them but cannot change them.
# NEON_SERVER__PUBLIC_URL=http://localhost:5173
# NEON_SECRETS__KEYS=
# NEON_SETTINGS__MAIL__ENABLED=true
# NEON_SETTINGS__MAIL__HOST=127.0.0.1
# NEON_SETTINGS__MAIL__PORT=51025
# NEON_SETTINGS__MAIL__TLS=none
# NEON_SETTINGS__MAIL__FROM=neon@example.com
