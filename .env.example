# Copy to .env, which git ignores. The values match deployments/docker-compose.dev.yml.

# Read by sqlx: the query macros at build time, sqlx-cli, and #[sqlx::test].
DATABASE_URL=postgres://neon:neon@127.0.0.1:55432/neon

# Read by the server. Any key of neon.example.yaml can be set this way.
NEON_DATABASE__URL=postgres://neon:neon@127.0.0.1:55432/neon
