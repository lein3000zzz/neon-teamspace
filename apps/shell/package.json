{
  "name": "neon-teamspace-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "browsers": "playwright install --only-shell chromium && playwright install webkit",
    "licenses": "bun ../../scripts/licenses.ts .",
    "check": "tsc && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
