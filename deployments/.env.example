# The settings of deployments/docker-compose.yml itself. Copy this file to deployments/.env,
# which git ignores, and change what the deployment needs; Compose reads it from beside the
# compose file. A variable left blank or commented out takes the default shown.
#
# The server's own settings are not here: they go in deployments/server.env, which
# server.env.example describes. Compose does not pass the variables below on to the server.

# --- Postgres ---

# The database user's password. Required, and read once, when the volume is first created.
# Letters and digits only, as it goes into the server's database URL; for example the
# output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Images ---

# The release whose published images docker-compose.yml runs on its own, for both the server
# and the web image. Unset, the release the Compose file belongs to, which its image lines
# name, so a new release's Compose file brings its images with it. Set, another release, or
# latest, which moves on to each new release as it is pulled. Ignored with
# docker-compose.build.yml, which builds both from this checkout instead.
NEON_VERSION=

# --- Web (Caddy) ---

# The domain people reach the instance at, such as neon.example.com. Caddy then gets and
# renews its TLS certificate itself and serves HTTPS on port 443, so publish ports 80 and
# 443 below and point the domain's DNS at this machine. Unset, Caddy serves plain HTTP, for
# local use or for TLS that ends in a proxy in front of it.
NEON_DOMAIN=

# Where the web container's ports 80 and 443 are published: a port, or an address and a
# port. The defaults keep it on this machine. With NEON_DOMAIN set, use 80 and 443.
NEON_HTTP_PORT=127.0.0.1:3000
NEON_HTTPS_PORT=127.0.0.1:3443

# Address ranges, separated by spaces, of proxies in front of Caddy whose X-Forwarded-For it
# believes, such as a load balancer's 10.0.0.0/8. None unless set.
NEON_WEB_TRUSTED_PROXIES=

# --- File storage ---

# With --profile seaweedfs: the access key SeaweedFS's S3 gateway signs requests with, neon
# unless set, and its secret, which the profile needs and refuses to start without; for
# example the output of: openssl rand -hex 32. Give the server the same two, as
# NEON_SETTINGS__ATTACHMENTS__S3__ACCESS_KEY_ID and ..._SECRET_ACCESS_KEY in server.env.
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=

# --- Development profiles ---

# Mailpit's inbox, with --profile mail.
MAILPIT_PORT=127.0.0.1:8025

# With --profile observability: Grafana, and OTLP and Pyroscope for a server outside the
# stack, as make run starts. Grafana signs everyone in as an admin: keep it on loopback.
GRAFANA_PORT=127.0.0.1:3001
OTLP_HTTP_PORT=127.0.0.1:4318
PYROSCOPE_PORT=127.0.0.1:4040
