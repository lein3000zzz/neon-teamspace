# The settings of deployments/docker-compose.yml. Copy this file to deployments/.env, which
# git ignores, and change what the deployment needs; Compose reads it from beside the compose
# file. A variable left blank or commented out takes the default shown.

# --- Postgres ---

# The database user's password. Required, and read once, when the volume is first created.
# Letters and digits only, as it goes into the server's database URL; for example the
# output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Images ---

# The images to run. Unset, both are built from this checkout as neon-workspace-server:local
# and neon-workspace-web:local. To run the published ones instead, name a release:
#   NEON_SERVER_IMAGE=ghcr.io/lein3000zzz/neon-workspace-server:0.1.0
#   NEON_WEB_IMAGE=ghcr.io/lein3000zzz/neon-workspace-web:0.1.0
NEON_SERVER_IMAGE=
NEON_WEB_IMAGE=

# --- Web (Caddy) ---

# The domain people reach the instance at, such as neon.example.com. Caddy then gets and
# renews its TLS certificate itself and serves HTTPS on port 443, so publish ports 80 and
# 443 below and point the domain's DNS at this machine. Unset, Caddy serves plain HTTP, for
# local use or for TLS that ends in a proxy in front of it.
NEON_DOMAIN=

# Where the web container's ports 80 and 443 are published: a port, or an address and a
# port. The defaults keep it on this machine. With NEON_DOMAIN set, use 80 and 443.
NEON_HTTP_PORT=127.0.0.1:3000
NEON_HTTPS_PORT=127.0.0.1:3443

# Address ranges, separated by spaces, of proxies in front of Caddy whose X-Forwarded-For it
# believes, such as a load balancer's 10.0.0.0/8. None unless set.
NEON_WEB_TRUSTED_PROXIES=

# --- The server ---
#
# These pass through to the server; the docs' Configuration page, at
# /docs/self-hosting/configuration/ on the instance, describes each key. The stack sets the
# database URL from POSTGRES_PASSWORD and puts the admin listener on 0.0.0.0:9090 inside its
# network, never published.

# Where people reach the instance, such as https://neon.example.com.
NEON_SERVER__PUBLIC_URL=

# The instance's name, shown in the app. Set here, the admin page cannot change it.
NEON_SETTINGS__INSTANCE__NAME=

# Logs: a filter directive such as info,sqlx=warn, and json or pretty.
NEON_OBSERVABILITY__LOGGING__LEVEL=
NEON_OBSERVABILITY__LOGGING__FORMAT=

# Traces, sent over OTLP to the observability profile's collector unless the endpoint names
# another, such as http://collector.internal:4318.
NEON_OBSERVABILITY__TRACING__ENABLED=
NEON_OBSERVABILITY__TRACING__ENDPOINT=
NEON_OBSERVABILITY__TRACING__SAMPLE_RATIO=

# Profiles: off, pull or push, which profiles as a list such as [cpu, heap], and for push,
# the Pyroscope server. The observability profile's is http://otel-lgtm:4040.
NEON_OBSERVABILITY__PROFILING__MODE=
NEON_OBSERVABILITY__PROFILING__PROFILES=
NEON_OBSERVABILITY__PROFILING__PUSH__SERVER_ADDRESS=

# --- Development profiles ---

# Mailpit's inbox, with --profile mail.
MAILPIT_PORT=127.0.0.1:8025

# With --profile observability: Grafana, and OTLP and Pyroscope for a server outside the
# stack, as make run starts. Grafana signs everyone in as an admin: keep it on loopback.
GRAFANA_PORT=127.0.0.1:3001
OTLP_HTTP_PORT=127.0.0.1:4318
PYROSCOPE_PORT=127.0.0.1:4040
