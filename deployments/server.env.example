# The server's settings in the Docker stack, as environment variables. Copy this file to
# deployments/server.env, which git ignores; the server reads it at its next start, and
# nothing else in the stack sees it. Without the file, every key keeps its default.
#
# Any key can be set here: NEON_, then the key's path in capitals with __ between levels, so
# database.max_connections is NEON_DATABASE__MAX_CONNECTIONS. The docs' Configuration page,
# at /docs/self-hosting/configuration/ on the instance, describes each key, and the settings
# reference, at /docs/reference/settings/, each runtime setting. The standard OTEL_
# variables of OpenTelemetry reach the server too.
#
# A blank value leaves its key to the default. Compose expands $ in values: put a value that
# holds one in single quotes, such as 'pa$word', to pass it as it is.
#
# The stack sets four keys itself, over anything said here: database.url, from
# POSTGRES_PASSWORD in deployments/.env; server.trusted_proxies, the private address ranges,
# as only the stack's containers reach the server; observability.admin.addr, 0.0.0.0:9090, so
# Prometheus can scrape the admin listener inside the stack's network, where it is never
# published; and updates.updater_token, from NEON_UPDATER_TOKEN in deployments/.env, even
# when that is blank, so the updater's token goes there, not here.

# Where people reach the instance, such as https://neon.example.com.
NEON_SERVER__PUBLIC_URL=

# The instance's name, shown in the app. Set here, the admin page cannot change it.
NEON_SETTINGS__INSTANCE__NAME=

# The first admin, made at start while no admin can sign in. Set both or neither; once an
# admin exists they do nothing.
NEON_ADMIN__EMAIL=
NEON_ADMIN__PASSWORD=

# The keys that seal secrets kept in the database, such as copies of invite codes and mail
# waiting to go: id:key entries separated by commas, each key 32 random bytes in base64, the
# newest first. Make one with: echo "$(date +%Y):$(openssl rand -base64 32)"
NEON_SECRETS__KEYS=

# Mail, through an SMTP server, or the mail profile's Mailpit: host mailpit, port 1025, TLS
# none. Mail also needs NEON_SERVER__PUBLIC_URL and NEON_SECRETS__KEYS above. Set here, the
# admin page cannot change them; leave them blank to set mail up there instead. TLS is
# starttls, tls or none. The docs' Mail page, at /docs/self-hosting/mail/, covers each.
NEON_SETTINGS__MAIL__ENABLED=
NEON_SETTINGS__MAIL__HOST=
NEON_SETTINGS__MAIL__PORT=
NEON_SETTINGS__MAIL__TLS=
NEON_SETTINGS__MAIL__USERNAME=
NEON_SETTINGS__MAIL__PASSWORD=
NEON_SETTINGS__MAIL__FROM=
NEON_SETTINGS__MAIL__FROM_NAME=

# Outgoing webhooks may reach a private network's addresses, such as a service on this
# stack's network, when true. Cloud metadata and reserved addresses stay refused either way.
# The docs' Webhooks guide, at /docs/guides/webhooks/, covers which addresses.
NEON_SETTINGS__WEBHOOKS__ALLOW_PRIVATE=

# Where attachments are kept: local, the default, in the volume neon_server-data, or s3, a
# bucket of an S3-compatible store, such as the seaweedfs profile's at http://seaweedfs:8333
# with the bucket neon and deployments/.env's SEAWEEDFS_ACCESS_KEY and SEAWEEDFS_SECRET_KEY.
# Set here, the admin page cannot change them. The docs' File storage page, at
# /docs/self-hosting/storage/, covers each.
NEON_SETTINGS__ATTACHMENTS__STORAGE=
NEON_SETTINGS__ATTACHMENTS__S3__ENDPOINT=
NEON_SETTINGS__ATTACHMENTS__S3__BUCKET=
NEON_SETTINGS__ATTACHMENTS__S3__ACCESS_KEY_ID=
NEON_SETTINGS__ATTACHMENTS__S3__SECRET_ACCESS_KEY=
# The largest file one upload takes, in bytes, 52428800 unless set.
NEON_SETTINGS__ATTACHMENTS__MAX_FILE_BYTES=

# The size of the database connection pool, 10 unless set.
NEON_DATABASE__MAX_CONNECTIONS=

# Logs: a filter directive such as info,sqlx=warn, and json or pretty.
NEON_OBSERVABILITY__LOGGING__LEVEL=
NEON_OBSERVABILITY__LOGGING__FORMAT=

# Traces, sent over OTLP to the observability profile's collector unless the endpoint names
# another, such as http://collector.internal:4318.
NEON_OBSERVABILITY__TRACING__ENABLED=
NEON_OBSERVABILITY__TRACING__ENDPOINT=
NEON_OBSERVABILITY__TRACING__SAMPLE_RATIO=

# Profiles: off, pull or push, which profiles as a list such as [cpu, heap], and for push,
# the Pyroscope server. The observability profile's is http://otel-lgtm:4040.
NEON_OBSERVABILITY__PROFILING__MODE=
NEON_OBSERVABILITY__PROFILING__PROFILES=
NEON_OBSERVABILITY__PROFILING__PUSH__SERVER_ADDRESS=
