{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.workspace_id, p.kind, p.teamspace_id, p.owner_id, p.parent_id,\n                  p.position, p.title, p.icon, p.cover, p.cover_file_id, p.font, p.small_text,\n                  p.full_width, p.created_by, p.last_edited_by, p.created_at, p.updated_at,\n                  p.content_updated_at, p.trashed_at, p.trashed_by, p.trashed_with,\n                  r.number,\n                  CASE WHEN $4::text[] IS NULL THEN r.cells\n                       ELSE COALESCE((SELECT jsonb_object_agg(k.key, r.cells -> k.key)\n                                      FROM unnest($4::text[]) AS k (key)\n                                      WHERE r.cells ? k.key), '{}'::jsonb)\n                  END AS \"cells!\",\n                  s.access AS \"shared?\"\n           FROM database_rows r\n           JOIN pages p ON p.id = r.page_id\n           LEFT JOIN page_shares s ON s.page_id = p.id AND s.user_id = $3\n           WHERE r.database_id = $1 AND p.trashed_with IS NOT DISTINCT FROM $2\n             AND ($5::uuid[] IS NULL OR r.page_id = ANY($5::uuid[]))\n           ORDER BY p.position, p.id",
