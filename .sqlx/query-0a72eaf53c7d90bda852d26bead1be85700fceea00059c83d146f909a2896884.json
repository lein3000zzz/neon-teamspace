  "query": "UPDATE users\n         SET display_name = COALESCE($2, display_name),\n             hue = CASE WHEN $3 THEN $4 ELSE hue END,\n             updated_at = $5\n         WHERE id = $1\n         RETURNING id, email, display_name, role, hue, email_verified_at, disabled_at,\n                   created_at, updated_at",
