  "query": "SELECT page_id, array_agg(id) AS \"ids!\", array_agg(created_at) AS \"times!\"\n           FROM page_versions\n           WHERE $1::uuid IS NULL OR page_id > $1\n           GROUP BY page_id\n           HAVING count(*) > 1 AND (min(created_at) < $2 OR count(*) > $3)\n           ORDER BY page_id\n           LIMIT $4",
