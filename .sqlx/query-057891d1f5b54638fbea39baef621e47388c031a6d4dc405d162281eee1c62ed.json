  "query": "SELECT id, page_id, created_at, authors, added, changed, removed, restored_from,\n                restored_from_at\n         FROM page_versions\n         WHERE page_id = $1\n           AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n         ORDER BY created_at DESC, id DESC\n         LIMIT $4",
