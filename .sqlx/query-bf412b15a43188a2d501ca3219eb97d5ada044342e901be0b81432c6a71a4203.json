  "query": "SELECT m.workspace_id, u.id, u.display_name, u.email, u.hue\n         FROM workspace_members m JOIN users u ON u.id = m.user_id\n         WHERE m.workspace_id = ANY($1) AND m.role = 'owner'\n         ORDER BY m.workspace_id, m.joined_at, u.id",
